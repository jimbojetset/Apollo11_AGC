@using Apollo11.Agc.Dsky
@using Apollo11.Agc.Hardware
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

<main class="@(_showSystems ? "workspace-open" : null)">
    <header class="page-header">
        <h1>@PanelTitle</h1>
        <div class="page-controls">
            <select id="rope" aria-label="Flight software" @bind:get="_ropeFile" @bind:set="ChangeRopeAsync" disabled="@(!_ready)">
                <option value="@Comanche">Comanche 055</option>
                <option value="@Luminary">Luminary 099</option>
            </select>
            <button type="button" class="systems-toggle" aria-controls="systems" aria-expanded="@(_showSystems ? "true" : "false")"
                    @onclick="() => _showSystems = !_showSystems">@(_showSystems ? "Hide systems" : "Show systems")</button>
        </div>
    </header>

    <div class="workspace">
        <section class="cockpit" aria-label="Cockpit">
            <div id="panel" class="panel" role="group" aria-label="@PanelTitle" style="aspect-ratio: @DskyFace.Width / @DskyFace.Height">
                <canvas id="face" width="@DskyFace.Width" height="@DskyFace.Height" aria-label="DSKY face and display"></canvas>
                @foreach (var (key, label, bounds) in DskyFace.KeyPositions)
                {
                    <button type="button" class="key" data-key="@key" data-code="@((int)key)" aria-label="@label.Replace('\n', ' ')"
                            style="--key-x:@bounds.X; --key-y:@bounds.Y; --key-w:@bounds.W; --key-h:@bounds.H"
                            disabled="@(!_ready || Uplink?.IsTransmitting == true)"></button>
                }
            </div>

            <p id="status" role="status" class="status" hidden="@(_status is null)">@_status</p>
            <p class="instructions">Try the lamp test with <kbd>VERB</kbd> <kbd>3</kbd> <kbd>5</kbd> <kbd>ENTR</kbd>.</p>
            <p class="shortcuts">Keyboard shortcuts <kbd>V</kbd> VERB · <kbd>N</kbd> NOUN · <kbd>Enter</kbd> ENTR · <kbd>P</kbd> PRO · <kbd>C</kbd> CLR · <kbd>K</kbd> KEY REL · <kbd>R</kbd> RSET</p>
        </section>

        <aside id="systems" class="systems" aria-label="Simulated systems" hidden="@(!_showSystems)">
            <header class="systems-header">
                <label for="system-picker">Systems</label>
                <select id="system-picker" @bind="_system">
                    <option value="@SystemPanel.GroundUplink">Ground Uplink</option>
                    <option value="@SystemPanel.Telemetry">Telemetry</option>
                    <option value="@SystemPanel.IoMonitor">I/O Monitor</option>
                </select>
            </header>

            @switch (_system)
            {
                case SystemPanel.GroundUplink:
                    var orbitResult = _ready ? Session?.OrbitResult : null;
                    <section class="system-content" aria-labelledby="ground-uplink-title">
                        <div class="system-title">
                            <h2 id="ground-uplink-title">Ground Uplink</h2>
                            <span class="uplink-state" role="status">@UplinkStatus</span>
                        </div>

                        <div class="uplink-scenario">
                            <h3>Earth orbit test</h3>
                            <p>Program 27 · CSM state vector</p>
                            @if (orbitResult is { } orbit)
                            {
                                <table class="orbit-comparison">
                                    <caption>Calculated orbit · V16 N44</caption>
                                    <thead><tr><th scope="col">Register</th><th scope="col">Target</th><th scope="col">DSKY result</th></tr></thead>
                                    <tbody>
                                        <tr>
                                            <th scope="row">R1 Apogee</th>
                                            <td>@ComancheOrbitUplink.TargetApogeeKilometres km</td>
                                            <td>
                                                <strong>@orbit.Apogee.Kilometres.ToString("0.000") km</strong>
                                                <span>@HeightDifference(orbit.Apogee, ComancheOrbitUplink.TargetApogeeKilometres)</span>
                                                <span><code>@orbit.Apogee.DskyText</code> · @orbit.Apogee.NauticalMiles.ToString("0.0") nmi</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th scope="row">R2 Perigee</th>
                                            <td>@ComancheOrbitUplink.TargetPerigeeKilometres km</td>
                                            <td>
                                                <strong>@orbit.Perigee.Kilometres.ToString("0.000") km</strong>
                                                <span>@HeightDifference(orbit.Perigee, ComancheOrbitUplink.TargetPerigeeKilometres)</span>
                                                <span><code>@orbit.Perigee.DskyText</code> · @orbit.Perigee.NauticalMiles.ToString("0.0") nmi</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p class="orbit-note"><strong>R3 <code>@orbit.TimeToReference</code></strong> · @(orbit.TimeToReference == "-59 59"
                                    ? "This orbit stays above 300,000 ft."
                                    : "Time to the 300,000 ft reference altitude.")</p>
                                <p class="orbit-note">Heights use the AGC’s launch-pad reference. One DSKY step is 0.1 nmi (185.2 m).</p>
                            }
                            else
                            {
                                <dl class="apsides">
                                    <div><dt>Target apogee</dt><dd>@ComancheOrbitUplink.TargetApogeeKilometres <span>km</span></dd></div>
                                    <div><dt>Target perigee</dt><dd>@ComancheOrbitUplink.TargetPerigeeKilometres <span>km</span></dd></div>
                                </dl>
                            }
                        </div>

                        <button type="button" class="send-vector" @onclick="SendStateVector"
                                disabled="@(!_ready || Uplink?.CanStart != true)">@UplinkButtonLabel</button>
                        @if (Uplink is { IsTransmitting: true } sending)
                        {
                            <progress max="@ComancheOrbitUplink.TotalWords" value="@sending.SentWords" aria-label="Uplink words sent"></progress>
                        }
                        @if (orbitResult is null)
                        {
                            <p class="system-feedback">@UplinkFeedback</p>
                        }
                    </section>
                    break;
                case SystemPanel.Telemetry:
                    <section class="system-content" aria-labelledby="telemetry-title">
                        <div class="system-title"><h2 id="telemetry-title">Telemetry</h2></div>
                        <dl class="channel-values">
                            <div><dt>Source</dt><dd>@(_spacecraft == DskySpacecraft.CommandModule ? "Columbia CMC" : "Eagle LGC")</dd></div>
                            <div><dt>Downlink channel <code>034</code></dt><dd><code>@Octal(Session?.DownlinkFirstWord)</code></dd></div>
                            <div><dt>Downlink channel <code>035</code></dt><dd><code>@Octal(Session?.DownlinkSecondWord)</code></dd></div>
                        </dl>
                        <p class="system-feedback">@(Session?.DownlinkFirstWord is null && Session?.DownlinkSecondWord is null
                            ? "Waiting for AGC downlink words." : "Latest raw downlink words in octal.")</p>
                    </section>
                    break;
                case SystemPanel.IoMonitor:
                    <section class="system-content" aria-labelledby="io-monitor-title">
                        <div class="system-title"><h2 id="io-monitor-title">I/O Monitor</h2></div>
                        <table class="channel-monitor">
                            <thead><tr><th scope="col">Signal</th><th scope="col">Channel</th><th scope="col">Value</th></tr></thead>
                            <tbody>
                                <tr><th scope="row">Ground uplink</th><td><code>173</code></td><td><code>@Octal(Uplink?.SentWords > 0 ? Session?.ChannelValue(AgcCpu.UplinkInputChannel) : null)</code></td></tr>
                                <tr><th scope="row">DSKY relays</th><td><code>010</code></td><td><code>@Octal(Session?.ChannelValue(0x08))</code></td></tr>
                                <tr><th scope="row">DSKY lamps</th><td><code>011</code></td><td><code>@Octal(Session?.ChannelValue(0x09))</code></td></tr>
                            </tbody>
                        </table>
                        <p class="system-feedback">UPLINK ACTY @(Session?.UplinkActivity == true ? "on" : "off")</p>
                    </section>
                    break;
            }
        </aside>
    </div>
</main>

@code {
    private const string Luminary = "Luminary099.bin";
    private const string Comanche = "Comanche055.bin";
    private DotNetObjectReference<WebDsky>? _session;
    private IJSObjectReference? _browser;
    private string _ropeFile = Comanche;
    private DskySpacecraft _spacecraft = DskySpacecraft.CommandModule;
    private bool _ready;
    private bool _showSystems = true;
    private SystemPanel _system;
    private string? _status = "Loading Comanche 055…";
    private string PanelTitle => _spacecraft == DskySpacecraft.CommandModule ? "Apollo 11 CM DSKY" : "Apollo 11 LM DSKY";
    private WebDsky? Session => _session?.Value;
    private ComancheOrbitUplink? Uplink => Session?.OrbitUplink;

    private enum SystemPanel { GroundUplink, Telemetry, IoMonitor }

    private string UplinkButtonLabel => Uplink switch
    {
        { IsTransmitting: true } => "Sending…",
        { IsComplete: true } => "State vector sent",
        _ => "Send state vector"
    };

    private string UplinkStatus => !_ready ? "Waiting for AGC" : _spacecraft != DskySpacecraft.CommandModule ? "Comanche only"
        : Uplink switch
        {
            { IsTransmitting: true } => "Transmitting",
            { Error: not null } => "Uplink failed",
            { IsComplete: true } => "Complete",
            { CanStart: true } => "Ready",
            _ => "Prepare DSKY"
        };

    private string UplinkFeedback => !_ready ? "Waiting for flight software to load."
        : _spacecraft != DskySpacecraft.CommandModule ? "Select Comanche 055 to send this preset."
        : Uplink switch
        {
            { IsTransmitting: true } => Session?.UplinkActivity == true
                ? "UPLINK ACTY is lit on the DSKY."
                : "Waiting for the guidance computer.",
            { Error: { } error } => error + " If P27 remains active, enter VERB 34 ENTR. Reset the DSKY before retrying.",
            { IsComplete: true } => "Key VERB 8 2 ENTR, then press and release PRO on the DSKY.",
            { CanStart: true } => "Sends the test orbit to Columbia’s guidance computer.",
            _ => "On the DSKY, press RSET, then key VERB 3 7 ENTR, 0 0 ENTR."
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var session = new WebDsky(await BootAsync(_ropeFile), _spacecraft);
            session.SystemsUpdated += RefreshSystems;
            _session = DotNetObjectReference.Create(session);
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dsky.js");
            _browser = await module.InvokeAsync<IJSObjectReference>("initialize", _session);
            _ready = true;
            _status = null;
        }
        catch (Exception error) when (error is HttpRequestException or IOException or InvalidDataException or JSException)
        {
            _status = $"Could not start the DSKY. {error.Message}";
        }

        StateHasChanged();
    }

    private void SendStateVector() => Session?.StartOrbitUplink();

    private void RefreshSystems()
    {
        if (_ready)
            _ = InvokeAsync(StateHasChanged);
    }

    private static string Octal(int? value) => value is { } word ? Convert.ToString(word, 8).PadLeft(5, '0') : "—";

    private static string HeightDifference(WebDsky.OrbitHeight height, int targetKilometres)
        => $"{(height.Kilometres - targetKilometres) * 1000m:+0;-0;0} m vs target";

    private async Task ChangeRopeAsync(string file)
    {
        if (!_ready || file == _ropeFile || file is not (Luminary or Comanche))
            return;

        var previousRope = _ropeFile;
        _ready = false;
        _ropeFile = file;
        _status = $"Loading {file}…";
        try
        {
            var cpu = await BootAsync(file);
            await _browser!.InvokeVoidAsync("resetInput");
            var spacecraft = file == Comanche ? DskySpacecraft.CommandModule : DskySpacecraft.LunarModule;
            _session!.Value.Reset(cpu, spacecraft);
            _spacecraft = spacecraft;
            _status = null;
        }
        catch (Exception error) when (error is HttpRequestException or IOException or InvalidDataException or JSException)
        {
            _ropeFile = previousRope;
            _status = $"Could not load {file}. {error.Message}";
        }
        finally
        {
            _ready = true;
        }
    }

    private async Task<AgcCpu> BootAsync(string file)
    {
        var rope = await Http.GetByteArrayAsync($"roms/{file}");
        if (rope.Length != 2 * AgcMemory.FixedBankCount * AgcMemory.FixedBankSize)
            throw new InvalidDataException($"{file} has an unexpected rope size.");

        var cpu = new AgcCpu();
        using var stream = new MemoryStream(rope);
        RopeImage.Load(stream, cpu.Memory);
        return cpu;
    }
}
